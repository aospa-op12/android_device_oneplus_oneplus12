import /odm/etc/init/hw/init.oplus.display.rc

on fs
    # Update touchpanel firmware in case we ship newer firmware in /odm
    write /proc/touchpanel/tp_fw_update 0

on boot
    # Display
    chmod 0000 /sys/kernel/oplus_display/hbm

    # TFA98xx calibration sysfs
    chown audioserver audio /sys/bus/i2c/devices/4-0034/reg
    chmod 0660 /sys/bus/i2c/devices/4-0034/reg
    chown audioserver audio /sys/bus/i2c/devices/4-0034/rw
    chmod 0660 /sys/bus/i2c/devices/4-0034/rw
    chown audioserver audio /sys/bus/i2c/devices/4-0035/reg
    chmod 0660 /sys/bus/i2c/devices/4-0035/reg
    chown audioserver audio /sys/bus/i2c/devices/4-0035/rw
    chmod 0660 /sys/bus/i2c/devices/4-0035/rw

on post-fs-data
    # ADSP ramdump
    mkdir /data/vendor/mmdump 0777 system system
    chmod 0777 /data/vendor/mmdump
    mkdir /data/vendor/mmdump/adsp 0777 system system
    chmod 0777 /data/vendor/mmdump/adsp

    # Audio HAL feedback
    chown media media /proc/mm_fb

    # Camera
    mkdir /mnt/vendor/persist 0771 root system
    chown cameraserver cameraserver /mnt/vendor/persist/camera/dual_calibration/stereoParams.bin
    chown cameraserver cameraserver /mnt/vendor/persist/camera/front_dual_calibration/stereoParams.bin
    chmod 0666 /mnt/vendor/persist/camera/dual_calibration/stereoParams.bin
    chmod 0666 /mnt/vendor/persist/camera/front_dual_calibration/stereoParams.bin
    chown cameraserver cameraserver /mnt/vendor/persist/camera/spectrum_cali_data
    chown cameraserver cameraserver /mnt/vendor/persist/camera/spectrum_test_data
    chmod 0666 /mnt/vendor/persist/camera/spectrum_cali_data
    chmod 0666 /mnt/vendor/persist/camera/spectrum_test_data
    chown cameraserver cameraserver /mnt/vendor/persist/camera/spectrum_sn.json
    chown cameraserver cameraserver /mnt/vendor/persist/camera/cm_tcs3449_*
    chmod 0666 /mnt/vendor/persist/camera/spectrum_sn.json
    chmod 0666 /mnt/vendor/persist/camera/cm_tcs3449_*
    mkdir /data/system/camera_rus 0777 cameraserver  cameraserver
    chown system system /sys/kernel/ois_control/dump_registers

    # Audio calibration
    mkdir /mnt/vendor/persist/media 0770 audioserver audio
    chown audioserver audio /mnt/vendor/persist/media
    chmod 0770 /mnt/vendor/persist/media
    restorecon /mnt/vendor/persist/media

on boot
    chown system system /sys/devices/platform/soc/ac0000.qcom,qupv3_1_geni_se/a90000.spi/spi_master/spi0/spi0.0/synaptics_tcm_hbp.0/double_tap_pressed
    chmod 0660 /sys/devices/platform/soc/ac0000.qcom,qupv3_1_geni_se/a90000.spi/spi_master/spi0/spi0.0/synaptics_tcm_hbp.0/double_tap_pressed
    chown system system /sys/devices/platform/soc/ac0000.qcom,qupv3_1_geni_se/a90000.spi/spi_master/spi0/spi0.0/synaptics_tcm_hbp.0/single_tap_pressed
    chmod 0660 /sys/devices/platform/soc/ac0000.qcom,qupv3_1_geni_se/a90000.spi/spi_master/spi0/spi0.0/synaptics_tcm_hbp.0/single_tap_pressed
    chown system system /sys/devices/platform/soc/ac0000.qcom,qupv3_1_geni_se/a90000.spi/spi_master/spi0/spi0.0/synaptics_tcm_hbp.0/fp_pressed
    chmod 0660 /sys/devices/platform/soc/ac0000.qcom,qupv3_1_geni_se/a90000.spi/spi_master/spi0/spi0.0/synaptics_tcm_hbp.0/fp_pressed

on property:ro.boot.prjname=*
    # Display
    setprop ro.separate.soft ${ro.boot.prjname}

on property:sys.boot_completed=1
    # Re-apply TFA98xx sysfs permissions in case the driver probed late
    chown audioserver audio /sys/bus/i2c/devices/4-0034/reg
    chmod 0660 /sys/bus/i2c/devices/4-0034/reg
    chown audioserver audio /sys/bus/i2c/devices/4-0034/rw
    chmod 0660 /sys/bus/i2c/devices/4-0034/rw
    chown audioserver audio /sys/bus/i2c/devices/4-0035/reg
    chmod 0660 /sys/bus/i2c/devices/4-0035/reg
    chown audioserver audio /sys/bus/i2c/devices/4-0035/rw
    chmod 0660 /sys/bus/i2c/devices/4-0035/rw

    # Network
    copy /vendor/etc/O_STX_platform_license.pfm /mnt/vendor/persist/data/pfm/licenses/O_STX_platform_license.pfm
    chmod 0600 /mnt/vendor/persist/data/pfm/licenses/O_STX_platform_license.pfm
    chown system system /mnt/vendor/persist/data/pfm/licenses/O_STX_platform_license.pfm

    copy /odm/etc/oem_stx_platform_license.pfm /mnt/vendor/persist/data/pfm/licenses/oem_stx_platform_license.pfm
    chmod 0600 /mnt/vendor/persist/data/pfm/licenses/oem_stx_platform_license.pfm
    chown system system /mnt/vendor/persist/data/pfm/licenses/oem_stx_platform_license.pfm

    copy /vendor/etc/O_TDD-Bypass_platform_license.pfm /mnt/vendor/persist/data/pfm/licenses/O_TDD-Bypass_platform_license.pfm
    chmod 0600 /mnt/vendor/persist/data/pfm/licenses/O_TDD-Bypass_platform_license.pfm
    chown system system /mnt/vendor/persist/data/pfm/licenses/O_TDD-Bypass_platform_license.pfm

    copy /vendor/etc/O_TDD-Bypass_SM7675_platform_license.pfm /mnt/vendor/persist/data/pfm/licenses/O_TDD-Bypass_SM7675_platform_license.pfm
    chmod 0600 /mnt/vendor/persist/data/pfm/licenses/O_TDD-Bypass_SM7675_platform_license.pfm
    chown system system /mnt/vendor/persist/data/pfm/licenses/O_TDD-Bypass_SM7675_platform_license.pfm

    # Widevine
    copy /vendor/etc/oplus_Widevine_licenses.pfm /mnt/vendor/persist/data/pfm/licenses/oplus_Widevine_licenses.pfm
    chmod 0600 /mnt/vendor/persist/data/pfm/licenses/oplus_Widevine_licenses.pfm
    chown system system /mnt/vendor/persist/data/pfm/licenses/oplus_Widevine_licenses.pfm

on property:debug.edge_grip_suppression=0
    setprop persist.vendor.edge_grip_suppression 0

on property:debug.edge_grip_suppression=1
    setprop persist.vendor.edge_grip_suppression 1

on property:debug.edge_grip_suppression=2
    setprop persist.vendor.edge_grip_suppression 2

on property:debug.edge_grip_suppression=3
    setprop persist.vendor.edge_grip_suppression 3

on property:debug.edge_grip_suppression=4
    setprop persist.vendor.edge_grip_suppression 4

on property:debug.edge_grip_suppression=5
    setprop persist.vendor.edge_grip_suppression 5
